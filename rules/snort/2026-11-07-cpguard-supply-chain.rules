# cPGuard Supply Chain Attack - Snort Detection Rules
# Date: 2026-11-07
# References:
#   https://thehackernews.com/2026/11/cpguard-update-channel-hijacked-to.html
#   https://opsshield.com/notice/security-incident-disclosure-servermanage.html

# Detect traffic to/from the attacker's known IP address
alert ip any any -> 94.183.188.91 any (msg:"CPGUARD SUPPLY-CHAIN Outbound connection to known attacker IP 94.183.188.91"; reference:url,opsshield.com/notice/security-incident-disclosure-servermanage.html; classtype:trojan-activity; sid:2026110701; rev:1; priority:1;)

alert ip 94.183.188.91 any -> any any (msg:"CPGUARD SUPPLY-CHAIN Inbound connection from known attacker IP 94.183.188.91"; reference:url,opsshield.com/notice/security-incident-disclosure-servermanage.html; classtype:trojan-activity; sid:2026110702; rev:1; priority:1;)

# Detect fake cPGuard User-Agent paired with attacker IP (revision: added destination IP constraint; legitimate cPGuard 5.88.11 installations produce the same UA, so UA alone is high-FP; downgraded to Low)
alert tcp any any -> 94.183.188.91 $HTTP_PORTS (msg:"CPGUARD SUPPLY-CHAIN Fake cPGuard 5.88.11 User-Agent to attacker IP"; flow:to_server,established; content:"User-Agent|3a| cPGuard/5.88.11"; http_header; reference:url,opsshield.com/notice/security-incident-disclosure-servermanage.html; classtype:trojan-activity; sid:2026110703; rev:2; priority:3;)

# DROPPED: SID 2026110704 (_rx.php exfiltration endpoint) - too generic; any PHP app with a receive/reaction endpoint matches. Not production-ready under strict leniency.
# DROPPED: SID 2026110706 (loot.tgz in URI) - "loot.tgz" is common in gaming, CTF, and pentesting contexts. Not distinctive enough for production use.

# Detect cpguard malicious update script name in HTTP traffic
alert tcp any any -> any $HTTP_PORTS (msg:"CPGUARD SUPPLY-CHAIN Malicious update script download cpguard-v58812-i91511"; flow:to_server,established; content:"cpguard-v58812-i91511"; http_uri; reference:url,opsshield.com/notice/security-incident-disclosure-servermanage.html; classtype:trojan-activity; sid:2026110705; rev:1; priority:1;)
