alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Actioner - Multipart POST with Session Upload Progress Key [Hunting]"; flow:established, to_server; http_method; content:"POST"; http_header; content:"multipart/form-data"; http_client_body; content:"PHP_SESSION_UPLOAD_PROGRESS", fast_pattern; detection_filter:track by_src, count 5, seconds 60; classtype:web-application-attack; reference:cve,2026-109619; reference:url,unit42.paloaltonetworks.com/cve-2026-109618-cve-2026-109619/; metadata:author Actioner, created 2026-10-31, cve CVE-2026-109619; sid:2100001; rev:2;)
