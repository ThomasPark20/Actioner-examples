# UAT-12643 / Overlord RAT / Good Game Stealer - Snort 2 Rules
# Cisco Talos - November 2026
# Reference: https://blog.talosintelligence.com/uat-12643-suspected-north-korea-aligned-actor-blends-blockchain-resilience-with-targeted-infostealing/

# SNORT-1: Solana JSON-RPC getSignaturesForAddress (C2 resolution)
alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"MALWARE UAT-12643 Solana RPC - getSignaturesForAddress C2 Resolution"; flow:established,to_server; content:"POST"; depth:4; content:"getSignaturesForAddress"; nocase; classtype:trojan-activity; reference:url,blog.talosintelligence.com/uat-12643-suspected-north-korea-aligned-actor-blends-blockchain-resilience-with-targeted-infostealing/; sid:9200001; rev:1;)

# SNORT-2: Solana JSON-RPC getTransaction with jsonParsed (C2 memo extraction)
alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"MALWARE UAT-12643 Solana RPC - getTransaction jsonParsed Memo Extraction"; flow:established,to_server; content:"POST"; depth:4; content:"getTransaction"; nocase; content:"jsonParsed"; nocase; classtype:trojan-activity; reference:url,blog.talosintelligence.com/uat-12643-suspected-north-korea-aligned-actor-blends-blockchain-resilience-with-targeted-infostealing/; sid:9200002; rev:1;)

# SNORT-3: Outbound connection to known staging/C2 IP 41.216.188.11
alert tcp $HOME_NET any -> 41.216.188.11 any (msg:"MALWARE UAT-12643 Overlord RAT - Connection to Known Staging Server 41.216.188.11"; flow:established,to_server; classtype:trojan-activity; reference:url,blog.talosintelligence.com/uat-12643-suspected-north-korea-aligned-actor-blends-blockchain-resilience-with-targeted-infostealing/; sid:9200003; rev:1;)

# SNORT-4: Microsoft BITS/7.8 User-Agent spoof (MSBuild stager)
alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"MALWARE UAT-12643 MSBuild Stager - Spoofed BITS User-Agent"; flow:established,to_server; content:"User-Agent|3a 20|Microsoft BITS/7.8"; nocase; classtype:trojan-activity; reference:url,blog.talosintelligence.com/uat-12643-suspected-north-korea-aligned-actor-blends-blockchain-resilience-with-targeted-infostealing/; sid:9200004; rev:1;)

# SNORT-5: Gofile.io exfiltration upload
alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"MALWARE UAT-12643 Good Game Stealer - Gofile Exfiltration Upload"; flow:established,to_server; content:"POST"; depth:4; content:"upload.gofile.io"; nocase; content:"/uploadFile"; nocase; classtype:trojan-activity; reference:url,blog.talosintelligence.com/uat-12643-suspected-north-korea-aligned-actor-blends-blockchain-resilience-with-targeted-infostealing/; sid:9200005; rev:1;)

# SNORT-6: Overlord RAT WebSocket C2 on port 5173
alert tcp $HOME_NET any -> $EXTERNAL_NET 5173 (msg:"MALWARE UAT-12643 Overlord RAT - WebSocket C2 on Port 5173"; flow:established,to_server; content:"Upgrade|3a 20|websocket"; nocase; classtype:trojan-activity; reference:url,blog.talosintelligence.com/uat-12643-suspected-north-korea-aligned-actor-blends-blockchain-resilience-with-targeted-infostealing/; sid:9200006; rev:1;)
