# DNS query for primary C2 domain 1688360.cc
alert dns $HOME_NET any -> any any (msg:"OPTIMJACK - DNS Query for Primary C2 Domain 1688360.cc"; dns.query; content:"1688360.cc"; nocase; sid:2200001; rev:1; metadata: author Actioner, created_at 2026_11_24, attack_id T1071.004;)

