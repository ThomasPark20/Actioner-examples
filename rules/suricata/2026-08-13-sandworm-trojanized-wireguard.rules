alert dns $HOME_NET any -> any any (msg:"Actioner - DNS Query to UAC-0145 SopraVPN Phishing Domain soprasteria-bg.com"; flow:to_server; dns.query; content:"soprasteria-bg.com"; nocase; fast_pattern; classtype:trojan-activity; reference:url,cert.gov.ua/article/6318863; metadata:author Actioner, created_at 2026-08-13; sid:2200001; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Actioner - HTTP Request to UAC-0145 Malicious SourceForge VPN Project"; flow:established,to_server; http.host; content:"sourceforge.net"; http.uri; content:"/projects/sopra"; fast_pattern; pcre:"/\/projects\/(soprabulgariavpn|sopravpn|soprasteriavpn)(\/|$)/"; classtype:trojan-activity; reference:url,cert.gov.ua/article/6318863; metadata:author Actioner, created_at 2026-08-13; sid:2200002; rev:2;)
