# ARMORY CASTLE / CVE-2026-123890 Suricata Rules
# Author: Actioner Research
# Date: 2026-11-20
# Reference: https://cloud.google.com/blog/topics/threat-intelligence/armory-castle-exploits-vsphere

# BEARBONES backdoored SSH banner detection
alert ssh any any -> any any (msg:"ACTIONER BEARBONES Backdoor SSH Banner Detected"; ssh.software; content:"pulsesecure_23345"; sid:2026001; rev:1; classtype:trojan-activity; metadata:mitre_technique_id T1036.005, cve CVE-2026-123890, affected_product VMware_vCenter, threat_actor ARMORY_CASTLE;)

# vCenter VAMI SSH enablement via PUT request
alert http any any -> any 5480 (msg:"ACTIONER vCenter VAMI SSH Enable via PUT"; flow:to_server,established; http.method; content:"PUT"; http.uri; content:"/rest/appliance/access/ssh"; sid:2026002; rev:1; classtype:policy-violation; metadata:mitre_technique_id T1021.004, cve CVE-2026-123890, affected_product VMware_vCenter, threat_actor ARMORY_CASTLE;)

