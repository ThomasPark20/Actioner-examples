alert ip any any -> 103.147.251.5 any (msg:"ACTIONER ARMORY CASTLE C2 IP 103.147.251.5"; sid:2026003; rev:1; classtype:trojan-activity; metadata:cve CVE-2026-123890, threat_actor ARMORY_CASTLE;)

