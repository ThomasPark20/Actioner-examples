alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE WeaselBiscuit C2 - Clipboard Monitoring Check"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/api/clipboard-status/"; reference:url,opensourcemalware.com/blog/introducing-weaselbiscuit; classtype:trojan-activity; sid:2026091805; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MALWARE WeaselBiscuit C2 - Keylogger Monitoring Check"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/api/keyboard-mouse-status/"; reference:url,opensourcemalware.com/blog/introducing-weaselbiscuit; classtype:trojan-activity; sid:2026091806; rev:1;)

alert http $HOME_NET any -> [103.170.217.184] any (msg:"MALWARE WeaselBiscuit Known C2 Server Communication"; flow:established,to_server; reference:url,opensourcemalware.com/blog/introducing-weaselbiscuit; classtype:trojan-activity; sid:2026091807; rev:1;)
