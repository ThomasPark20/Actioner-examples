# Suricata Rules for CVE-2026-114938 (Java4Shell)
# WARNING: uncompiled (structural check only) - validate in your environment
#
# References:
#   https://calif.io/java4shell
#   https://thehackernews.com/2026/11/java4shell-cve-2026-114938-enables-pre.html
#   https://blackpointcyber.com/blog/java4shell-cve-2026-114938-java-base64-decoder-flaw/
#   https://blog.talosintelligence.com/java4shell/
#   Cisco Talos Snort SIDs: 1:67502-1:67513 (official, requires Talos subscription)

# Rule 1: Detect java4shell-recon User-Agent in HTTP requests
# Confidence: HIGH - specific IOC observed in the wild by watchTowr
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ACTIONER Java4Shell CVE-2026-114938 Recon Scanner User-Agent"; flow:established,to_server; http.user_agent; content:"java4shell-recon"; nocase; classtype:web-application-attack; sid:9026001; rev:1; metadata:cve CVE-2026-114938, created_at 2026_11_20, confidence high;)

# Rule 2: Detect malformed Base64 in HTTP Basic Authorization header
# The trigger payload is 64+ 'A' characters followed by '=' padding.
# Confidence: MEDIUM - heuristic based on known trigger pattern
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ACTIONER Java4Shell CVE-2026-114938 Malformed Base64 in Authorization Header"; flow:established,to_server; http.header; content:"Authorization|3a 20|Basic "; content:"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"; distance:0; content:"="; distance:0; within:3; classtype:web-application-attack; sid:9026002; rev:1; metadata:cve CVE-2026-114938, created_at 2026_11_20, confidence medium;)

# Rule 3: Detect 128-character 'A' run targeting OpenJDK 17 specifically
# On OpenJDK 17, the trigger requires 128 'A' characters + '='
# Confidence: MEDIUM - specific to JDK 17 trigger variant
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ACTIONER Java4Shell CVE-2026-114938 JDK17 Trigger Pattern in Auth Header"; flow:established,to_server; http.header; content:"Authorization|3a 20|Basic "; content:"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"; distance:0; content:"="; distance:0; within:3; classtype:web-application-attack; sid:9026004; rev:1; metadata:cve CVE-2026-114938, created_at 2026_11_20, confidence medium;)
