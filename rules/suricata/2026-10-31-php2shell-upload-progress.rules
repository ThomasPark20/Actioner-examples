alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Actioner - Multipart POST with Session Upload Progress Key [Hunting]"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"multipart/form-data"; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; fast_pattern; threshold:type threshold, track by_src, count 5, seconds 60; classtype:web-application-attack; reference:cve,2026-109619; reference:url,unit42.paloaltonetworks.com/cve-2026-109618-cve-2026-109619/; metadata:author Actioner, created_at 2026-10-31, cve CVE-2026-109619; sid:2200001; rev:2;)
