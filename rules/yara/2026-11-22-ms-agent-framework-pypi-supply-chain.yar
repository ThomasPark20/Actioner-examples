rule Supply_Chain_Agent_Framework_Wheel_Malicious
{
    meta:
        description = "Detects the malicious agent-framework wheel archives (v1.26.1 and v1.26.2)"
        author = "Actioner"
        date = "2026-11-22"
        reference = "https://www.wiz.io/blog/malicious-version-of-microsofts-agent-framework-published-to-pypi"
        hash_v1 = "d27fa34414e6201d5e03e559ef634f020057554d7b3f4898dd5d7cd3e989e110"
        hash_v2 = "3d20a8bc91351a9a16b6db243b848ceca0206b7a8623b02d2af553a9c9f7e0a9"
        severity = "high"

    strings:
        $whl_name1 = "agent_framework-1.26.1" ascii
        $whl_name2 = "agent_framework-1.26.2" ascii
        $pth1 = "agent_framework_meta.pth" ascii
        $pth2 = "af_runtime_diag.pth" ascii
        $stealer1 = "_telemetry.py" ascii
        $stealer2 = "af_runtime_diag.py" ascii
        $b64_url = "aHR0cHM6Ly93ZWJob29rLnNpdGUvZDM4MWZkODAtZWM2Mi00MmFkLThmNWMtZDFiMTUxMDNjOWJi" ascii

    condition:
        filesize < 5MB and
        (1 of ($whl_name*)) and
        (1 of ($pth*) or 1 of ($stealer*) or $b64_url)
}
