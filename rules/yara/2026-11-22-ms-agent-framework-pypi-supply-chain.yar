rule Supply_Chain_Agent_Framework_PTH_Hook
{
    meta:
        description = "Detects malicious .pth startup hook files from the agent-framework PyPI supply chain attack (v1.26.1 agent_framework_meta.pth and v1.26.2 af_runtime_diag.pth)"
        author = "Actioner"
        date = "2026-11-22"
        reference = "https://www.wiz.io/blog/malicious-version-of-microsofts-agent-framework-published-to-pypi"
        hash_v1 = "21f28e8517a10ffe431f8d68f5875c85eca4001ae6d118322b0a41873998eb5e"
        hash_v2 = "325e7e9f0ec94e41ad1a1b7a3f18a6b8b5bffece2e2b97b8d3369eb967452f93"
        severity = "high"

    strings:
        $pth_import1 = "import agent_framework_meta" ascii
        $pth_import2 = "import af_runtime_diag" ascii

    condition:
        filesize < 1KB and
        any of ($pth_import*)
}

rule Supply_Chain_Agent_Framework_Stealer_Telemetry
{
    meta:
        description = "Detects the _telemetry.py credential stealer payload from agent-framework v1.26.1"
        author = "Actioner"
        date = "2026-11-22"
        reference = "https://www.wiz.io/blog/malicious-version-of-microsofts-agent-framework-published-to-pypi"
        hash = "39fa329f2a93f734b0bb8f5adb203ea3331d1ae479832a5015a54cb17aabd663"
        sha1 = "0a013e4724c4437cf9b177def1d988113e167539"
        severity = "high"

    strings:
        $func_start = "_start" ascii
        $func_telemetry = "_telemetry" ascii
        $ua = "af-runtime-diagnostics/1" ascii
        $env_guard = "_AF_TEL" ascii
        $b64_url = "aHR0cHM6Ly93ZWJob29rLnNpdGUvZDM4MWZkODAtZWM2Mi00MmFkLThmNWMtZDFiMTUxMDNjOWJi" ascii
        $proc_environ = "/proc/" ascii
        $imds = "169.254.169.254" ascii
        $fork = "os.fork" ascii
        $setsid = "os.setsid" ascii
        $zlib = "zlib.compress" ascii

    condition:
        filesize < 500KB and
        $b64_url and
        3 of ($func_start, $func_telemetry, $ua, $env_guard, $proc_environ, $imds, $fork, $setsid, $zlib)
}

